{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Decision Preview",
  "version": "0.1.0",
  "identifier": "dev.decision.desktop.preview",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "startup",
        "title": "Decision Preview",
        "width": 680,
        "height": 520,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; frame-src 'none'; object-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.png", "icons/icon.icns"],
    "resources": {
      "../../.local/desktop/runtime/": "runtime/"
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    }
  }
}
