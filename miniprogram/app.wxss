page { background: #f4f6f3; color: #20352d; font-size: 30rpx; }
.container { padding: 32rpx; padding-bottom: 80rpx; }
.title { font-size: 44rpx; font-weight: 700; margin: 12rpx 0 24rpx; }
.subtitle, .meta { color: #61736b; font-size: 26rpx; margin: 12rpx 0; }
.card { background: #fff; border: 1rpx solid #dce5df; border-radius: 20rpx; padding: 26rpx; margin: 22rpx 0; }
input, textarea { box-sizing: border-box; width: 100%; padding: 20rpx; background: #f4f6f3; border-radius: 12rpx; margin: 16rpx 0; }
textarea { min-height: 160rpx; }
button { margin: 16rpx 0; font-size: 28rpx; border-radius: 12rpx; }
button[type=primary] { background: #285c49; }
.error { color: #9b3028; white-space: pre-wrap; padding: 16rpx 0; }
.notice { color: #78551c; background: #fff1d8; padding: 18rpx; border-radius: 12rpx; margin: 16rpx 0; }
.body { white-space: pre-wrap; word-break: break-all; line-height: 1.7; }
.tabs { display: flex; flex-wrap: wrap; gap: 12rpx; }
.tabs button { flex: 1; min-width: 130rpx; }
.selected { color: #fff; background: #285c49; }
.quote { border-left: 6rpx solid #b9ccc0; padding: 16rpx; background: #f4f6f3; margin: 12rpx 0; }
.row { display: flex; gap: 16rpx; }
.row button { flex: 1; }
