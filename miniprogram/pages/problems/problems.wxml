<view class="container">
  <view class="title">我的问题</view><view class="subtitle">与网页共用服务器记录，选择问题后继续讨论。</view>
  <view class="error" wx:if="{{error}}">{{error}}</view>
  <button size="mini" loading="{{loading}}" bindtap="refresh">刷新</button>
  <view class="card" wx:for="{{items}}" wx:key="id" data-id="{{item.id}}" bindtap="open"><view>{{item.title}}</view><view class="meta">{{item.goal}}</view><view class="meta">{{item.updatedAt}}</view></view>
  <view class="meta" wx:if="{{!items.length && !loading}}">还没有问题，可以从下面创建。</view>
  <button wx:if="{{nextCursor}}" disabled="{{loading}}" bindtap="more">加载更多</button>
  <view class="card"><view>新建问题</view>
    <input placeholder="当前要解决什么？" value="{{title}}" data-field="title" bindinput="input" disabled="{{busy}}" maxlength="200" />
    <textarea placeholder="希望达成的目标" value="{{goal}}" data-field="goal" bindinput="input" disabled="{{busy}}" maxlength="4000" />
    <textarea placeholder="已有约束，每行一条（可选）" value="{{constraints}}" data-field="constraints" bindinput="input" disabled="{{busy}}" maxlength="4000" />
    <textarea placeholder="尚不清楚的条件，每行一条（可选）" value="{{unknowns}}" data-field="unknowns" bindinput="input" disabled="{{busy}}" maxlength="4000" />
    <button type="primary" bindtap="create" loading="{{busy}}" disabled="{{busy}}">创建并讨论</button>
  </view><button bindtap="logout">退出登录</button>
</view>
